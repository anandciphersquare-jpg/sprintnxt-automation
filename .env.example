# Copy to .env and fill in. Nothing here is committed.

SNXT_BASE_URL=https://uat.sprintnxt.in/NexGenFront
SNXT_SIGNUP_PATH=/#/signup
SNXT_LOGIN_PATH=/#/login
SNXT_FORGOT_PATH=/#/forgot-password
SNXT_CHANGE_PW_PATH=/#/manage/change-password

# Fixed UAT OTP used for email + mobile verification
SNXT_OTP=123456

# --- Admin (NOT provided in the shared screenshots) ---
# Fill these to enable admin login + merchant-activation tests.
SNXT_ADMIN_URL=https://uat.sprintnxt.in/NexGenAdminFront/#/auth/login
SNXT_ADMIN_USER=
SNXT_ADMIN_PASS=

# --- A seeded, already-activated merchant ---
# Used by login / change-password / forgot-password positive tests.
SNXT_MERCHANT_EMAIL=
SNXT_MERCHANT_PASS=

# --- Behaviour ---
SNXT_HEADLESS=true
SNXT_SLOWMO=0
SNXT_TIMEOUT_MS=15000
